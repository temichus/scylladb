pipeline {
    agent {
        label {
            label "gce-qavpc"
        }
    }
     parameters {

        string(defaultValue: '',
               description: 'Scylla relocatable packages build to be used',
               name: 'scylla_version')

        string(defaultValue: 'git@github.com:scylladb/scylla-ccm.git',
               description: 'ccm git repo',
               name: 'ccm_repo')

        string(defaultValue: 'master',
               description: 'ccm git branch',
               name: 'ccm_branch')

        string(defaultValue: '',
               description: 'manager build path',
               name: 'scylla_manager_package')

        string(defaultValue: '720',
               description: 'timeout for jenkins job in minutes',
               name: 'timeout')
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout([time: params.timeout, unit: "MINUTES"])
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        NOSE_PROCESSES = "2"
    }
    stages {
        stage('Checkout') {
           steps {
              dir('scylla-dtest') {
                  checkout scm
                  dir("scylla-ccm") {
                    git(url: params.ccm_repo,
                        credentialsId:'b8a774da-0e46-4c91-9f74-09caebaea261',
                        branch: params.ccm_branch)
                  }
              }
           }
        }
        stage('Starting minio server')
        {
            steps {
                script {
                    MINIO_ACCESS_KEY_ID = "access"
                    MINIO_SECRET_ACCESS_KEY = "secretkey"
                    MINIO_DOCKER_ID = sh(script: """docker run -d -e "MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY_ID}"   -e "MINIO_SECRET_KEY=${MINIO_SECRET_ACCESS_KEY}"   -v \$(pwd)/minio_data:/data   minio/minio server /data""",
                                  returnStdout: true).trim()
                }
            }
        }
        stage('Run dtest Tests') {
            steps {
                script {
                    wrap([$class: 'BuildUser']) {
                        dir('scylla-dtest') {

                            sh """
                            #!/bin/bash
                            set -xe
                            env

                            export CLUSTER_ID_ALLOCATOR=random
                            export SCYLLA_VERSION="${params.scylla_version}"
                            if [ \${#SCYLLA_VERSION} -eq "0" ]; then
                                export SCYLLA_BRANCH="master"
                                export LATEST_SCYLLA_BUILD_ID=`aws s3 --no-sign-request ls downloads.scylladb.com/relocatable/unstable/\$SCYLLA_BRANCH/ | tr -s ' ' | cut -d ' ' -f 3 | tr -d '\\/'  | sort -g | grep "....-" | tail -n 1`
                                export SCYLLA_VERSION="unstable/"\$SCYLLA_BRANCH":"\$LATEST_SCYLLA_BUILD_ID
                            fi
                            export CCM_DIR=\$(pwd)"/scylla-ccm"
                            export PRINT_DEBUG=False
                            export DEBUG=False
                            export KEEP_TEST_DIR=True
                            export SCYLLA_MANAGER_PACKAGE="${params.scylla_manager_package}"
                            export MINIO_DOCKER_ID="${MINIO_DOCKER_ID}"
                            export AWS_ACCESS_KEY_ID="${MINIO_ACCESS_KEY_ID}"
                            export AWS_SECRET_ACCESS_KEY="${MINIO_SECRET_ACCESS_KEY}"

                            export HOME=\$(pwd)/tmp_dtest_run
                            mkdir -p \$HOME
                            rm -Rf \$(pwd)/tmp_dtest_run

                            # export SCYLLA_EXT_OPTS="--smp 2 --memory 1024M"  # TODO: Figure out why do multi shard nodes cause the repair to extremely slow down
                            echo "NOSE_PROCESSES=${NOSE_PROCESSES}"

                            export INSTALL_CASSANDRA='ccm create scylla-tmp --scylla -n 1 --version=${SCYLLA_VERSION}'

                            echo "start test ......."

                            ./scripts/run_test.sh -a scylla-manager --with-xunitmp --xunitmp-file="\$HOME/results.xml"  --process-restart --process-timeout=7200
                            echo "end test ....."
                            """
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            sh """
                docker kill ${MINIO_DOCKER_ID}
                docker run -v `pwd`/minio_data:/data -w /data busybox sh -c "find . -user root -name '*' | xargs chmod ugo+rw"
                rm -rf ./minio_data
            """

            // fix the format of reporting
            sh "sed -i 's/skip=/skipped=/' \$(pwd)/scylla-dtest/tmp_dtest_run/results.xml"

            archiveArtifacts artifacts: '**/results.xml', fingerprint: true
            archiveArtifacts artifacts: 'scylla-dtest/logs/**', fingerprint: true

            xunit thresholds: [failed(unstableThreshold: '1'), skipped()],
                  tools: [JUnit(pattern: '**/results.xml')]

            sh """
                rm -Rf \$(pwd)/scylla-dtest/tmp_dtest_run
            """
        }
    }
}
