pipeline {
    agent {
        label {
            label "gce-qavpc"
        }
    }
     parameters {

        string(defaultValue: 'release:4.6',
               description: 'Scylla relocatable packages build to be used',
               name: 'scylla_version')

        string(defaultValue: 'git@github.com:scylladb/scylla-ccm.git',
               description: 'ccm git repo',
               name: 'ccm_repo')

        string(defaultValue: 'master',
               description: 'ccm git branch',
               name: 'ccm_branch')

        string(defaultValue: '',
               description: 'manager build path',
               name: 'scylla_manager_package')

        string(defaultValue: '720',
               description: 'timeout for jenkins job in minutes',
               name: 'timeout')

        string(defaultValue: 'qa@scylladb.com,mgmt@scylladb.com',
               description: 'The email address to send the report. If empty - will take qa@scylladb.com',
               name: 'email_address')
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout([time: params.timeout, unit: "MINUTES"])
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        AWS_ACCESS_KEY_ID     = credentials('qa-aws-secret-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('qa-aws-secret-access-key')
        GITHUB_TOKEN = credentials('github-api-access-token')
    }
    stages {
        stage('Checkout') {
           steps {
              dir('scylla-dtest') {
                  checkout scm
                  dir("scylla-ccm") {
                    git(url: params.ccm_repo,
                        credentialsId:'b8a774da-0e46-4c91-9f74-09caebaea261',
                        branch: params.ccm_branch)
                  }
              }
           }
        }
        stage('Run dtest Tests') {
            steps {
                script {
                    wrap([$class: 'BuildUser']) {
                        dir('scylla-dtest') {

                            sh """
                            #!/bin/bash
                            set -xe
                            env

                            export SCYLLA_VERSION="${params.scylla_version}"
                            if [ \${#SCYLLA_VERSION} -eq "0" ]; then
                                export SCYLLA_BRANCH="master"
                                export LATEST_SCYLLA_BUILD_ID=`aws s3 --no-sign-request ls downloads.scylladb.com/unstable/scylla/\${SCYLLA_BRANCH}/relocatable/ | tr -s ' ' | cut -d ' ' -f 3 | tr -d '\\/'  | sort -g | grep "....-" | tail -n 1`
                                export SCYLLA_VERSION="unstable/"\$SCYLLA_BRANCH":"\$LATEST_SCYLLA_BUILD_ID
                            fi
                            export CCM_DIR=\$(pwd)"/scylla-ccm"
                            export SCYLLA_MANAGER_PACKAGE="${params.scylla_manager_package}"

                            export HOME=\$(pwd)/tmp_dtest_run
                            mkdir -p \$HOME
                            rm -Rf \$(pwd)/tmp_dtest_run

                            # export SCYLLA_EXT_OPTS="--smp 2 --memory 1024M"  # TODO: Figure out why do multi shard nodes cause the repair to extremely slow down

                            export INSTALL_CASSANDRA='ccm create scylla-tmp --scylla -n 1 --version=\${SCYLLA_VERSION} --scylla-manager-package=\${SCYLLA_MANAGER_PACKAGE}'

                            echo "start test ......."
                            export PYTEST_CAPTURE=" " # make sure capturing is on, so mail would have the full errors in the attachments
                            ./scripts/run_test.sh -m="scylla_manager" manager_*.py --junit-xml="\$HOME/results.xml" --scylla-version=\${SCYLLA_VERSION} --scylla-manager-package=${params.scylla_manager_package} \
                                --html=report.html --email ${params.email_address} --self-contained-html

                            echo "end test ....."
                            """
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            // Todo: see if you can create multiple 'always' stages, independent of one another.
            archiveArtifacts artifacts: 'scylla-dtest/logs/**', fingerprint: true,  allowEmptyArchive: true

            // fix the format of reporting
            sh script: "sed -i 's/skip=/skipped=/' \$(pwd)/scylla-dtest/tmp_dtest_run/results.xml", returnStatus: true

            archiveArtifacts artifacts: '**/results.xml', fingerprint: true,  allowEmptyArchive: true

            xunit thresholds: [failed(unstableThreshold: '1'), skipped()],
                  tools: [JUnit(pattern: '**/results.xml', skipNoTestFiles: true)]

            sh script: """
                rm -Rf \$(pwd)/scylla-dtest/tmp_dtest_run
            """, returnStatus: true
        }
    }
}
