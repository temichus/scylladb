#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'dtest@snapshot', retriever: legacySCM(scm)
library identifier: 'camunda-shared-library'
library identifier: 'pipeline-logparser-shared-library@3.2'

dtestGatingPipeline(
    BUILD_MODE: 'release',
    PRODUCT_NAME: 'scylla',
    BRANCH: 'master',
    INCLUDE_DTESTS:  "-m 'not skip and next_gating'",
)
