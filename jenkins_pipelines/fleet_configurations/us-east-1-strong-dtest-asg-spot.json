{
    "AutoScalingGroupName": "strong-dtest-spot",
    "MixedInstancesPolicy": {
        "LaunchTemplate": {
            "LaunchTemplateSpecification": {
                "LaunchTemplateName": "dtest-asg-template",
                "Version": "$Latest"
            },
            "Overrides": [
                {
                    "InstanceRequirements": {
                        "VCpuCount": {
                            "Min": 28,
                            "Max": 32
                        },
                        "ExcludedInstanceTypes": [
                            "c3.8xlarge",
                            "i2.8xlarge",
                            "m5d.8xlarge",
                            "r3.8xlarge",
                            "x1e.8xlarge"
                        ],
                        "MemoryMiB": {
                            "Min": 7168,
                            "Max": 262144
                        },
                        "LocalStorage": "required",
                        "LocalStorageTypes": [
                            "ssd"
                        ],
                        "TotalLocalStorageGB": {
                            "Min": 100.0,
                            "Max": 2000.0
                        }
                    }
                }
            ]
        },
        "InstancesDistribution": {
            "OnDemandAllocationStrategy": "lowest-price",
            "OnDemandBaseCapacity": 0,
            "OnDemandPercentageAboveBaseCapacity": 0,
            "SpotAllocationStrategy": "price-capacity-optimized"
        }
    },
    "MinSize": 0,
    "MaxSize": 200,
    "DesiredCapacity": 0,
    "DefaultCooldown": 300,
    "AvailabilityZones": [
        "us-east-1a",
        "us-east-1b",
        "us-east-1c",
        "us-east-1d",
        "us-east-1f"
    ],
    "HealthCheckType": "EC2",
    "HealthCheckGracePeriod": 300,
    "VPCZoneIdentifier": "subnet-08be0e5fba2c59e3d,subnet-0bb3f61e0cad91b38,subnet-064aa9ef4f305eba2,subnet-025324c72eb8f6fb6,subnet-04283454acdc3fd86",
    "Tags": [
        {
            "Key": "Name",
            "Value": "strong-dtest-asg-spot",
            "PropagateAtLaunch": true
        },
        {
            "Key": "keep",
            "Value": "4",
            "PropagateAtLaunch": true
        },
        {
            "Key": "keep_action",
            "Value": "terminate",
            "PropagateAtLaunch": true
        }
    ],
    "TerminationPolicies": [
        "Default"
    ],
    "NewInstancesProtectedFromScaleIn": false,
    "ServiceLinkedRoleARN": "arn:aws:iam::158855661827:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling",
    "CapacityRebalance": true,
    "DesiredCapacityType": "units"
}
