#!/bin/bash
#
# Usage:
#
# scripts/setup-virtualenv --virtualenv-root=PATH --python=PATH

PYTHON='python3.7'

PROGRAM=$(basename $0)

usage() {
    echo "usage: $PROGRAM --virtualenv-root=PATH --python=PATH"
}

set -e

for i in "$@"
do
case $i in
    -v=*|--virtualenv-root*)
    VIRTUALENV_ROOT="${i#*=}"
    shift
    ;;
    -p=*|--python*)
    PYTHON="${i#*=}"
    shift
    ;;
    *)
    echo "error: unknown command line option: $i"
    usage
    exit 1
    ;;
esac
done

if [ -z $VIRTUALENV_ROOT ]; then
    echo "error: no virtualenv root defined, use the --virtualenv-root option to specify that"
    usage
    exit 1
fi

echo "VIRTUALENV_ROOT = $VIRTUALENV_ROOT"
echo "CASSANDRA_DRIVER_VERSION = $CASSANDRA_DRIVER_VERSION"
echo "THRIFT_VERSION = $THRIFT_VERSION"
echo "PYTHON = $PYTHON"

#
# Setup virtualenv:
#

rm -rf $VIRTUALENV_ROOT
$PYTHON -m venv $VIRTUALENV_OPTS $VIRTUALENV_ROOT
source $VIRTUALENV_ROOT/bin/activate
pip install setuptools==45.1.0 pip==20.0.2
pip install -r requirements.txt
